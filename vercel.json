{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/assets/$1"
    },
    {
      "src": "/canvaskit/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "dest": "/canvaskit/$1"
    },
    {
      "src": "/favicon.png",
      "headers": { "cache-control": "public, max-age=86400" },
      "dest": "/favicon.png"
    },
    {
      "src": "/manifest.json",
      "headers": { "cache-control": "public, max-age=0, must-revalidate" },
      "dest": "/manifest.json"
    },
    {
      "src": "/flutter.js",
      "dest": "/flutter.js"
    },
    {
      "src": "/flutter_bootstrap.js",
      "dest": "/flutter_bootstrap.js"
    },
    {
      "src": "/flutter_service_worker.js",
      "dest": "/flutter_service_worker.js"
    },
    {
      "src": "/main.dart.js",
      "dest": "/main.dart.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
